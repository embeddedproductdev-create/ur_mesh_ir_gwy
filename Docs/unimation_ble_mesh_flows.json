    {
        "id": "fn_parse_incoming",
        "type": "function",
        "z": "tab_unimation",
        "g": "grp_subscribe",
        "name": "Parse & Route by JsonPacketID",
        "func": "// Parse payload if string\nvar data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch(e) {\n        node.warn('Invalid JSON: ' + msg.payload);\n        return null;\n    }\n}\nmsg.payload = data;\nmsg.packetId = data.JsonPacketID;\nmsg.gwySerNo = data.GwySerNo || 'unknown';\nmsg.nodeSerNo = data.NodeSerNo || null;\nmsg.elementAddr = data.ElementAddr || null;\n\n// Store last seen gateway\nflow.set('LastGateway', msg.gwySerNo);\n\nnode.status({\n    fill: data.ErrorCode === 1 ? 'green' : 'red',\n    shape: 'dot',\n    text: 'ID:' + msg.packetId + ' GWY:' + msg.gwySerNo + (msg.nodeSerNo ? ' NODE:' + msg.nodeSerNo : '')\n});\n\nreturn msg;",
        "outputs": 1,
        "x": 560,
        "y": 1100,
        "wires": [
            [
                "dbg_all_raw",
                "sw_packet_router"
            ]
        ]
    },
