    {
        "id": "fn_publish_router",
        "type": "function",
        "z": "tab_unimation",
        "g": "grp_publish",
        "name": "Build Topic → {GwySerNo}/commands",
        "func": "var gwy = flow.get('GwySerNo') || 'GWY00001';\nmsg.topic = gwy + '/command';\nif (typeof msg.payload === 'object') {\n    msg.payload = JSON.stringify(msg.payload);\n}\nnode.status({fill:'green', shape:'dot', text: 'Sent to ' + msg.topic});\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 520,
        "wires": [
