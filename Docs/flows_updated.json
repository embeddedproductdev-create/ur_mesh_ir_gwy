    {
        "id": "fn_parse_incoming",
        "type": "function",
        "z": "tab_unimation", "g": "grp_subscribe",
        "name": "Parse & Route by JsonPacketID",
        "func": "var data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch(e) {\n        node.warn('Invalid JSON: ' + msg.payload);\n        return null;\n    }\n}\nmsg.payload = data;\nmsg.packetId = data.JsonPacketID;\nmsg.gwySerNo = data.GwySerNo || 'unknown';\nmsg.nodeSerNo = data.NodeSerNo || null;\nmsg.elementAddr = data.ElementAddr || null;\nmsg.groupAddr = data.GroupAddr || null;\n\nflow.set('LastGateway', msg.gwySerNo);\n\nvar idLabels = {\n    1:'GWY IR Config',4:'GWY Manual AC',6:'GWY Heartbeat',\n    13:'GWY AC ACK',16:'GWY Grp Sub ACK',17:'GWY Grp Unsub ACK',\n    100:'NODE Prov',101:'NODE IR Config',104:'NODE Manual AC',106:'NODE Heartbeat',\n    113:'NODE AC ACK',116:'NODE Grp Sub ACK',117:'NODE Grp Unsub ACK',\n    119:'Grp Immediate ACK',120:'Grp Summary ACK'\n};\nvar label = idLabels[msg.packetId] || 'ID:'+msg.packetId;\n\nnode.status({\n    fill: data.ErrorCode === 0 ? 'green' : 'red',\n    shape: 'dot',\n    text: label + ' GWY:' + msg.gwySerNo + (msg.nodeSerNo ? ' NODE:' + msg.nodeSerNo : '') + (msg.groupAddr ? ' GRP:' + msg.groupAddr : '')\n});\n\nreturn msg;",
        "outputs": 1, "x": 560, "y": 1340,
        "wires": [["dbg_all_raw", "sw_packet_router"]]
    },
    {
        "id": "dbg_all_raw",
